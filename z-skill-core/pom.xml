<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-skill</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-skill-core</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>z-skill-core</name>
    <description>发现 + 归一化 + 聚合 + 检索 + 静态扫描 + REST/兼容出口</description>

    <!-- 原 <properties> 的 maven.compiler.source/target=8、project.build.sourceEncoding=UTF-8 已删除:
         父链 z-boot-parent:1.0.19 提供同值. -->

    <dependencies>
        <!-- 版本由仓库根 dependencyManagement 的 project.version 自钉提供(不再写 revision 属性),
             这样 reactor 版本不会被 z-boot-fleet 的 z-skill* 槽位改写. -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-skill-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-skill</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-message</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-types</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-agent-kernel-tool</artifactId>
        </dependency>

        <!-- 以下第三方坐标(spring-web/spring-webmvc/spring-boot/jackson-databind/slf4j-api/
             junit:junit/spring-boot-starter-test/javax.servlet-api)原本靠本仓 import 的
             spring-boot-dependencies:2.7.18 给版本; 现在由父链 z-boot-dependencies:1.0.19 里
             同一版 spring-boot-dependencies:2.7.18 给 — 依赖声明不动, 一行 <version> 都不必留. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 主代码不许碰 servlet(装配契约, 见 CoreStaysServletFreeTest); 只有 MockMvc 那几条测试要拿
             javax.servlet 的类型做断言, 所以放在 test 域, 连 provided 都不给 — provided 也不会传递到
             下游模块, 摆在那儿只会诱使主代码再写一次 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>